# Build output
/bin/
dist/           # goreleaser output (root or per-module, e.g. clients/cli/dist)
*.exe
*.dll
*.so
*.dylib
*.test
*.out
coverage.txt
coverage.html

# Env / secrets (never commit)
.env
.env.*
!.env.example

# Go
/vendor/
go.work.sum

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Node (docs tooling, if ever vendored)
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# go-task internal cache
.task/

# Python packaging metadata
*.egg-info/

# GitHub workflow files are NOT tracked: the push token deliberately lacks the
# 'workflow' scope (D-026). The live copy under .github/ is local-only; the
# tracked source of truth is deploy/ci/github-ci.yml — enable it once via the
# GitHub web UI (Add file -> .github/workflows/ci.yml).
.github/
