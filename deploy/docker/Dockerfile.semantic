# syntax=docker/dockerfile:1
# Semantic service image (D-023/D-029): two-stage python-slim build.
#   docker build -f deploy/docker/Dockerfile.semantic -t membrane/semantic:dev .
# Stage 1 builds wheels; the runtime stage installs from those wheels only
# (no compilers, no pip index access) and runs as a dedicated non-root user.

FROM python:3.12-slim AS build
WORKDIR /src
COPY services/semantic/ .
RUN pip wheel --no-cache-dir --wheel-dir /wheels .

FROM python:3.12-slim
RUN useradd --system --uid 10001 --no-create-home membrane
COPY --from=build /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels membrane-semantic \
 && rm -rf /wheels
USER membrane
EXPOSE 8005
CMD ["python", "-m", "semantic.main"]
