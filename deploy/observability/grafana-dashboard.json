{
  "__comment": "MEMBRANE.AI overview dashboard (D-032). Import into Grafana; expects a Prometheus datasource scraping the OTLP collector's metrics and a Tempo datasource for traces. Panels key on membrane_verdicts_total{decision,source}.",
  "title": "MEMBRANE.AI — Overview",
  "uid": "membrane-overview",
  "schemaVersion": 39,
  "tags": ["membrane", "governance"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Verdicts / sec by decision",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (decision) (rate(membrane_verdicts_total[5m]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Verdict mix (decision)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (decision) (increase(membrane_verdicts_total[1h]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache effectiveness (source)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum by (source) (rate(membrane_verdicts_total[5m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rejected verdicts (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(membrane_verdicts_total{decision=\"rejected\"}[1h]))"
        }
      ]
    }
  ]
}
