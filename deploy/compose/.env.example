# Copy to .env (gitignored) and adjust for local runs.
# Ingestion service (prefix MEMBRANE_INGESTION_):
MEMBRANE_INGESTION_GRPC_ADDR=:9001
MEMBRANE_INGESTION_HTTP_ADDR=:8001
MEMBRANE_INGESTION_HEALTH_ADDR=:8101
MEMBRANE_INGESTION_KAFKA_BROKERS=localhost:9092
MEMBRANE_INGESTION_KAFKA_TOPIC=code.submission.v1
MEMBRANE_INGESTION_USE_IN_MEMORY=false
MEMBRANE_INGESTION_WEBHOOK_SECRET=
MEMBRANE_INGESTION_LOG_LEVEL=info

# Orchestrator service (prefix MEMBRANE_ORCHESTRATOR_):
MEMBRANE_ORCHESTRATOR_HEALTH_ADDR=:8102
MEMBRANE_ORCHESTRATOR_KAFKA_BROKERS=localhost:9092
MEMBRANE_ORCHESTRATOR_SUBMISSION_TOPIC=code.submission.v1
MEMBRANE_ORCHESTRATOR_VERDICT_TOPIC=code.verdict.v1
MEMBRANE_ORCHESTRATOR_CONSUMER_GROUP=orchestrator
MEMBRANE_ORCHESTRATOR_REDIS_ADDR=localhost:6379
MEMBRANE_ORCHESTRATOR_CACHE_TTL=72h
MEMBRANE_ORCHESTRATOR_STAGE_DEADLINE=1200ms
MEMBRANE_ORCHESTRATOR_RULESET_VERSION=v1
MEMBRANE_ORCHESTRATOR_USE_IN_MEMORY=false
MEMBRANE_ORCHESTRATOR_LOG_LEVEL=info
# Empty = in-process secret-scan only; set to host:port to use the analyzer service.
MEMBRANE_ORCHESTRATOR_ANALYZER_ADDR=localhost:9003
# Verdict audit + transactional outbox (D-013):
MEMBRANE_ORCHESTRATOR_DATABASE_URL=postgres://membrane:membrane@localhost:5432/membrane
MEMBRANE_ORCHESTRATOR_OUTBOX_INTERVAL=500ms
MEMBRANE_ORCHESTRATOR_OUTBOX_BATCH=100

# Analyzer service (prefix MEMBRANE_ANALYZER_):
MEMBRANE_ANALYZER_GRPC_ADDR=:9003
MEMBRANE_ANALYZER_HEALTH_ADDR=:8103
MEMBRANE_ANALYZER_LOG_LEVEL=info

# Resolver service (prefix MEMBRANE_RESOLVER_):
MEMBRANE_RESOLVER_GRPC_ADDR=:9004
MEMBRANE_RESOLVER_HEALTH_ADDR=:8104
MEMBRANE_RESOLVER_DATABASE_URL=postgres://membrane:membrane@localhost:5432/membrane
MEMBRANE_RESOLVER_EMBED_DIM=3072
MEMBRANE_RESOLVER_LOG_LEVEL=info

# Reporter service (prefix MEMBRANE_REPORTER_):
MEMBRANE_REPORTER_HEALTH_ADDR=:8105
MEMBRANE_REPORTER_WEBHOOK_URL=
MEMBRANE_REPORTER_LOG_LEVEL=info
# GitHub commit-status notifier (empty token = disabled; API URL only for GHE):
MEMBRANE_REPORTER_GITHUB_TOKEN=
MEMBRANE_REPORTER_GITHUB_API_URL=
