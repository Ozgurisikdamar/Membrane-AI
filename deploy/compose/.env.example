# Copy to .env (gitignored) and adjust for local runs.
# Ingestion service (prefix MEMBRANE_INGESTION_):
MEMBRANE_INGESTION_GRPC_ADDR=:9001
MEMBRANE_INGESTION_HTTP_ADDR=:8001
MEMBRANE_INGESTION_HEALTH_ADDR=:8101
MEMBRANE_INGESTION_KAFKA_BROKERS=localhost:9092
MEMBRANE_INGESTION_KAFKA_TOPIC=code.submission.v1
MEMBRANE_INGESTION_USE_IN_MEMORY=false
MEMBRANE_INGESTION_WEBHOOK_SECRET=
MEMBRANE_INGESTION_LOG_LEVEL=info

# Orchestrator service (prefix MEMBRANE_ORCHESTRATOR_):
MEMBRANE_ORCHESTRATOR_HEALTH_ADDR=:8102
MEMBRANE_ORCHESTRATOR_KAFKA_BROKERS=localhost:9092
MEMBRANE_ORCHESTRATOR_SUBMISSION_TOPIC=code.submission.v1
MEMBRANE_ORCHESTRATOR_VERDICT_TOPIC=code.verdict.v1
MEMBRANE_ORCHESTRATOR_CONSUMER_GROUP=orchestrator
MEMBRANE_ORCHESTRATOR_REDIS_ADDR=localhost:6379
MEMBRANE_ORCHESTRATOR_CACHE_TTL=72h
MEMBRANE_ORCHESTRATOR_STAGE_DEADLINE=1200ms
MEMBRANE_ORCHESTRATOR_RULESET_VERSION=v1
MEMBRANE_ORCHESTRATOR_USE_IN_MEMORY=false
MEMBRANE_ORCHESTRATOR_LOG_LEVEL=info
